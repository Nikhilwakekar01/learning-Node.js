<%- include('../partials/head')%>
</head>
<body class="bg-[#FFFFFC] flex-col justify-items-center">
    <%- include('../partials/nav')%>
    <header class="mt-6 flex justify-center items-center text-black font-mono font-bold text-4xl">
        <h1>Login</h1>
    </header>
    <main class="mt-10">
        <form class=" bg-[#87daf5]  border rounded-lg flex justify-center w-fit h-fit p-5 py-10 flex-col items-center justify-item-center shadow-md backdrop:blur-sm shadow-slate-900" action='/login' method="POST">
            
            <input class="bg-white text-gray-700 m-5 border outline-none hover:shadow-xl shadow-md transition duration-300 rounded-xl p-2 hover:scale-[1.02]" 
              placeholder="Enter your email " type='text' name='email' required></input>

            <input class="bg-white text-gray-700 m-5 border outline-none hover:shadow-xl shadow-md transition duration-300 rounded-xl p-2 hover:scale-[1.02]" placeholder="Password " type='password' name='password' required></input>  

            <input class="border  shadow-slate-700 rounded-lg bg-white text-black w-fit h-fit p-2 px-4 shadow-md hover:shadow-xl transition duration-300 hover:scale-[1.02]" type="submit" value='LogIn'></input>
        </form>

    </main>
    
</body>
</html>